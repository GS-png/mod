<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>EraOfWheel</RootNamespace>
    <AssemblyName>EraOfWheel</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>11</LangVersion>
    <OutputType>Library</OutputType>
    <RefsDir>$(ProjectDir)Refs\</RefsDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildModPackage" AfterTargets="Build">
    <PropertyGroup>
      <ModPackageDir>$(ProjectDir)dist\EraOfWheel\</ModPackageDir>
    </PropertyGroup>

    <ItemGroup>
      <ModResourceFiles Include="Resources\**\*" />
    </ItemGroup>

    <MakeDir Directories="$(ModPackageDir)" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModPackageDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModPackageDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(ProjectDir)mod.json" DestinationFolder="$(ModPackageDir)" Condition="Exists('$(ProjectDir)mod.json')" />

    <Copy
      SourceFiles="@(ModResourceFiles)"
      DestinationFiles="@(ModResourceFiles->'$(ModPackageDir)Resources\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ValidateExternalReferences" BeforeTargets="Build">
    <Error Condition="!Exists('$(RefsDir)NeoModLoader.dll')" Text="Missing reference: EraOfWheel/Refs/NeoModLoader.dll" />
    <Error Condition="!Exists('$(RefsDir)Assembly-CSharp-Publicized.dll')" Text="Missing reference: EraOfWheel/Refs/Assembly-CSharp-Publicized.dll" />
    <Error Condition="!Exists('$(RefsDir)UnityEngine.dll')" Text="Missing reference: EraOfWheel/Refs/UnityEngine.dll" />
    <Error Condition="!Exists('$(RefsDir)UnityEngine.CoreModule.dll')" Text="Missing reference: EraOfWheel/Refs/UnityEngine.CoreModule.dll" />
    <Error Condition="!Exists('$(RefsDir)UnityEngine.UIModule.dll')" Text="Missing reference: EraOfWheel/Refs/UnityEngine.UIModule.dll" />
    <Error Condition="!Exists('$(RefsDir)UnityEngine.UI.dll')" Text="Missing reference: EraOfWheel/Refs/UnityEngine.UI.dll" />
    <Error Condition="!Exists('$(RefsDir)UnityEngine.TextRenderingModule.dll')" Text="Missing reference: EraOfWheel/Refs/UnityEngine.TextRenderingModule.dll" />
    <Error Condition="!Exists('$(RefsDir)UnityEngine.UnityWebRequestModule.dll')" Text="Missing reference: EraOfWheel/Refs/UnityEngine.UnityWebRequestModule.dll" />
  </Target>

  <Target Name="ValidateExternalReferencesEarly" BeforeTargets="ResolveReferences;CoreCompile">
    <CallTarget Targets="ValidateExternalReferences" />
  </Target>

  <ItemGroup>
    <Reference Include="NeoModLoader">
      <HintPath>$(RefsDir)NeoModLoader.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RefsDir)Assembly-CSharp-Publicized.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RefsDir)UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RefsDir)UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(RefsDir)UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(RefsDir)UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RefsDir)UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(RefsDir)UnityEngine.UnityWebRequestModule.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
